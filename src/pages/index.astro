---
import Layout from "../layouts/Layout.astro";
import Benefits from "../sections/Benefits.astro";
import Contacto from "../sections/Contacto.astro";
import Data from "../sections/Data.astro";
import Footer from "../sections/Footer.astro";
import OffGrid from "../sections/OffGrid.astro";
import OnGrid from "../sections/OnGrid.astro";
import Data2 from "../sections/Data2.astro";
import Hero from "../sections/Hero.astro";
import DividerUp from "@/sections/DividerUp.astro";
import DividerDown from "@/sections/DividerDown.astro";

const title = "Energia Riojana | Home";
---

<Layout title={title}>
	<Hero />

	<main
		class="flex flex-col items-center justify-center text-gray-800 py-8 md:py-24"
	>
		<Benefits />
		<DividerUp />
		<Data />
		<DividerDown />
		<div class="flex flex-col gap-8 items-center justify-center">
			<OnGrid />
			<OffGrid />
		</div>
		<DividerUp />
		<Data2 />
		<DividerDown />
		<Contacto />
	</main>
	<!-- <Footer /> -->
</Layout>
