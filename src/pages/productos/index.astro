---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Energía Riojana | Productos">
  <main
    class="flex min-h-[60vh] flex-col items-center justify-center bg-brand-gradient px-6 py-24 text-center text-white"
  >
    <p class="text-eyebrow mb-4">Energía Riojana</p>
    <h1 class="max-w-4xl">Productos</h1>
    <p class="text-lead mt-6 max-w-2xl text-white/90">
      Soluciones solares para hogares, comercios e industrias de La Rioja.
    </p>
  </main>
</Layout>
