---
import Layout from "@/layouts/Layout.astro";
import HeroObras from "../../sections/obras/HeroObras.astro";
import AltaTension from "../../sections/obras/AltaTension.astro";
import MediaTension from "../../sections/obras/MediaTension.astro";
import Iluminacion from "../../sections/obras/Iluminacion.astro";
---

<Layout title="Energia Riojana | Alta Tencion">
    <HeroObras />
    <main class="flex flex-col items-center justify-center text-gray-800">
        <section class="flex flex-col w-5/6 md:w-3/4 py-8 md:py-24 gap-8">
            <AltaTension />
            <MediaTension />
            <Iluminacion />
        </section>
    </main>
</Layout>
