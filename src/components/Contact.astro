---
// Netlify form: the data-netlify/honeypot/action attributes are build-time
// infrastructure — Netlify parses them from the static HTML. Do not remove.
const fieldClasses =
  "block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 shadow-sm focus:border-brand focus:ring-2 focus:ring-brand/40 focus:outline-none";
const labelClasses = "mb-2 block text-sm font-medium text-gray-600";
---

<form
    class="flex flex-col gap-2 p-4"
    netlify-honeypot="bot-field"
    data-netlify="true"
    name="contact"
    action="/success"
    method="POST"
>
    <input type="hidden" name="form-name" value="contact" />
    <input
        type="text"
        name="bot-field"
        class="hidden"
        tabindex="-1"
        autocomplete="off"
    />
    <div>
        <label for="email" class={labelClasses}>Tu correo</label>
        <input
            type="email"
            id="email"
            class={fieldClasses}
            placeholder="tucorreo@tucorreo.com"
            required
            name="email"
        />
    </div>
    <div>
        <label for="subject" class={labelClasses}>Asunto</label>
        <input
            type="text"
            id="subject"
            class={fieldClasses}
            placeholder="Dejame aqui el asunto de tu mensaje"
            required
            name="asunto"
        />
    </div>
    <div>
        <label for="telefono" class={labelClasses}>Teléfono</label>
        <input
            type="tel"
            id="telefono"
            name="telefono"
            inputmode="tel"
            autocomplete="tel"
            pattern="\\+?[0-9\\s()\\-]{7,20}"
            class={fieldClasses}
            placeholder="+54 9 380 000 0000"
            required
        />
    </div>
    <div class="sm:col-span-2">
        <label for="message" class={labelClasses}>Tu mensaje</label>
        <textarea
            name="mensaje"
            id="message"
            rows="6"
            class={fieldClasses}
            placeholder="Escribe aqui tu mensaje"></textarea>
    </div>
    <button
        type="submit"
        class="my-4 inline-flex items-center gap-2 self-start rounded-full bg-brand px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-orange focus:ring-4 focus:ring-brand/40 focus:outline-none"
        >Enviar mensaje</button
    >
</form>
