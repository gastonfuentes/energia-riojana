---
import { getImage } from "astro:assets";
import imagen_hero from "../assets/images/hero-home.jpg";

const heroImage = await getImage({ src: imagen_hero });
---

<section
  class="relative flex min-h-screen flex-col overflow-hidden bg-cover bg-center text-white md:h-screen"
  style={`background-image: url(${heroImage.src});`}
>
  <!-- Overlay for legibility over the photo -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/45 to-black/80"
  >
  </div>

  <div
    class="relative z-10 flex flex-1 flex-col items-center justify-center gap-5 px-6 pt-24 pb-16 text-center"
  >
    <p class="text-eyebrow text-white/80">Bienvenidos a la energía renovable</p>
    <h1 class="text-[clamp(1.5rem,6vw,4.25rem)] leading-[1.05]">
      <span class="whitespace-nowrap">Hay mucha Rioja en el sol,</span><br />
      y lo vamos a aprovechar.
    </h1>
    <p class="text-lead max-w-2xl text-white/85">
      En Energía Riojana impulsamos el desarrollo sostenible de nuestra
      provincia, transformando la fuerza del sol en bienestar para todos.
    </p>
    <a
      href="/institucional"
      class="group mt-1 inline-flex items-center gap-3 rounded-full bg-brand px-7 py-3 font-semibold text-white transition-colors hover:bg-brand-orange"
    >
      Conocenos
      <span
        class="grid h-7 w-7 place-items-center rounded-full bg-white/20 transition-transform group-hover:translate-x-1"
        >&rarr;</span
      >
    </a>
  </div>
</section>
