---
import { getImage } from "astro:assets";
import imagen_hero from "../assets/images/hero-home.jpg";
import cardHogarImg from "../assets/images/home-card-hogar.jpg";
import cardPymesImg from "../assets/images/home-card-pymes.jpg";
import cardIndustriaImg from "../assets/images/home-card-industria.jpg";
import Icon from "../components/Icon.astro";

const heroImage = await getImage({ src: imagen_hero });
const hogarImage = await getImage({ src: cardHogarImg, width: 900 });
const pymesImage = await getImage({ src: cardPymesImg, width: 900 });
const industriaImage = await getImage({ src: cardIndustriaImg, width: 900 });

const phone = "5493804331153";
const cards = [
  {
    title: "Hogar",
    cta: "Pedí tu kit",
    icon: "icon-home-fridge",
    msg: "Hola, me comunico solicitando más información sobre el kit de energía solar para el hogar.",
    image: hogarImage.src,
    featured: true,
  },
  {
    title: "Pymes",
    cta: "Pedí tu presupuesto",
    icon: "icon-commercial-pos",
    msg: "Hola, me comunico solicitando más información sobre productos y planes para empresas.",
    image: pymesImage.src,
    featured: false,
  },
  {
    title: "Industria y Agro",
    cta: "Pedí tu presupuesto",
    icon: "icon-industrial-factory",
    msg: "Hola, me comunico solicitando más información sobre productos y planes para industrias y agro.",
    image: industriaImage.src,
    featured: false,
  },
];

const waLink = (msg: string) =>
  `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;

// Opacity logic: "active" card shows its image, the rest show red + icon.
// Default active = featured; hovering any card makes THAT one active.
const imageClasses = (featured: boolean) =>
  featured
    ? "opacity-100 group-hover/cards:opacity-0 group-hover/card:opacity-100!"
    : "opacity-0 group-hover/card:opacity-100";
const iconClasses = (featured: boolean) =>
  featured
    ? "opacity-0 group-hover/cards:opacity-100 group-hover/card:opacity-0!"
    : "opacity-100 group-hover/card:opacity-0";
---

<section
  class="relative flex min-h-screen flex-col overflow-hidden bg-cover bg-center text-white md:h-screen"
  style={`background-image: url(${heroImage.src});`}
>
  <!-- Overlay for legibility over the photo -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/45 to-black/80"
  >
  </div>

  <!-- Hero copy (takes the central space) -->
  <div
    class="relative z-10 flex flex-1 flex-col items-center justify-center gap-5 px-6 pt-24 text-center"
  >
    <p class="text-eyebrow text-white/80">Bienvenidos a la energía renovable</p>
    <h1 class="text-[clamp(1.5rem,6vw,4.25rem)] leading-[1.05]">
      <span class="whitespace-nowrap">Hay mucha Rioja en el sol,</span><br />
      y lo vamos a aprovechar.
    </h1>
    <p class="text-lead max-w-2xl text-white/85">
      En Energía Riojana impulsamos el desarrollo sostenible de nuestra
      provincia, transformando la fuerza del sol en bienestar para todos.
    </p>
    <a
      href="/institucional"
      class="group mt-1 inline-flex items-center gap-3 rounded-full bg-brand px-7 py-3 font-semibold text-white transition-colors hover:bg-brand-orange"
    >
      Conocenos
      <span
        class="grid h-7 w-7 place-items-center rounded-full bg-white/20 transition-transform group-hover:translate-x-1"
        >&rarr;</span
      >
    </a>
  </div>

  <!-- Category cards: active one shows image, inactive ones show red + icon.
       Hover activates the hovered card. One active at a time (pure CSS). -->
  <div
    class="group/cards relative z-10 mx-auto grid w-11/12 max-w-6xl gap-4 pb-8 md:grid-cols-3"
  >
    {
      cards.map((card) => (
        <article class="group/card relative flex min-h-56 flex-col justify-between overflow-hidden rounded-2xl bg-brand p-6 shadow-lg ring-1 ring-white/15 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl">
          <div
            class:list={[
              "absolute inset-0 transition-opacity duration-300",
              imageClasses(card.featured),
            ]}
          >
            <img
              src={card.image}
              alt=""
              class="h-full w-full object-cover transition-transform duration-500 group-hover/card:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent" />
          </div>

          <div
            class:list={[
              "relative z-10 transition-opacity duration-300",
              iconClasses(card.featured),
            ]}
          >
            <Icon name={card.icon} size="2.75rem" class="text-white" />
          </div>

          <div class="relative z-10 flex flex-col items-start gap-3">
            <h3 class="text-xl font-bold tracking-wide text-white uppercase">
              {card.title}
            </h3>
            <a
              href={waLink(card.msg)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-brand transition-transform hover:scale-105"
            >
              {card.cta}
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
