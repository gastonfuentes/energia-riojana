---
import Layout from "@/layouts/Layout.astro";
---

<Layout
    title="Página no encontrada | Energía Riojana S.A."
    description="La página que buscás no existe o fue movida."
    noindex
>
    <main class="flex flex-col items-center justify-center min-h-screen">
        <article
            class="p-4 md:p-8 bg-gray-100 rounded-2xl flex flex-col gap-2 md:gap-4"
        >
            <header
                class="flex flex-col p-8 bg-gray-200 rounded-xl items-center"
            >
                <h1 class="text-5xl font-bold text-red-600 mb-2">404</h1>
                <h2 class="text-2xl font-semibold mb-2">
                    Página no encontrada
                </h2>
            </header>
            <div class="flex flex-col gap-2 md:text-xl items-center">
                <p class="rounded-xl p-4">
                    Lo sentimos, la página que buscas no existe o fue movida.
                </p>
            </div>
            <a
                href="/"
                class="mt-6 text-brand font-semibold underline"
                >Volver al inicio</a
            >
        </article>
    </main>
</Layout>
