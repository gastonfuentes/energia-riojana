---
import Layout from "@/layouts/Layout.astro";
---

<Layout
    title="Consulta enviada | Energía Riojana S.A."
    description="Recibimos tu consulta. Te respondemos a la brevedad."
    noindex
>
    <main class="flex flex-col items-center justify-center min-h-screen">
        <article
            class="p-4 md:p-8 bg-gray-100 rounded-2xl flex flex-col gap-2 md:gap-4"
        >
            <header class="flex flex-col p-8 bg-gray-200 rounded-xl">
                <div>
                    <h1 class="text-4xl font-bold rounded-xl">
                        ¡Envío exitoso!
                    </h1>
                </div>
            </header>
            <div class="flex flex-col md:flex-row gap-4 md:text-xl">
                <p class="md:w-1/2 rounded-xl p-4">
                    Tu formulario fue enviado correctamente.
                </p>
                <p class="md:w-1/2 bg-gray-100 rounded-xl p-4">
                    Nos pondremos en contacto contigo a la brevedad.
                </p>
            </div>
            <a
                href="/"
                class="mt-6 text-brand font-semibold underline"
                >Volver al inicio</a
            >
        </article>
    </main>
</Layout>
