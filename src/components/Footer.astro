---
import { Image } from "astro:assets";
import logo_horizontal from "../assets/logo-horizontal-blanco.svg";
import { MdAlternateEmail } from "react-icons/md";
import { MdLocationOn, MdPhone } from "react-icons/md";
import ersa_qr from "../assets/ersa_qr.png";
import { address, email, instagram, phone } from "../data/contact";

/**
 * Copyright range: first publication year through the year of the build.
 *
 * A redesign does not reset the notice — the site was first published in
 * 2025 and that is the year the copyright runs from. The closing year is
 * computed rather than typed because a hand-written one is stale every
 * January, and a footer frozen in a past year reads as an abandoned site.
 *
 * Astro is static, so this resolves at BUILD time, not on the visitor's
 * clock. Any deploy after New Year's refreshes it; a site left unbuilt for
 * over a year would still show the old closing year.
 */
const FIRST_PUBLISHED = 2025;
const currentYear = new Date().getFullYear();
const copyrightYears =
  currentYear > FIRST_PUBLISHED
    ? `${FIRST_PUBLISHED}–${currentYear}`
    : `${FIRST_PUBLISHED}`;
---

<footer
    class="bg-gray-800 p-8 md:p-0 dark:bg-gray-900"
>
    <div class="mx-auto w-full max-w-screen-xl p-4 py-6 lg:py-12">
        <div class="md:flex md:justify-between">
            <div class="mb-6 md:mb-0 flex items-center">
                <Image
                    src={logo_horizontal}
                    alt="logo horizontal ersa"
                    width="250"
                />
            </div>
            <div class="grid grid-cols-1 gap-8 sm:gap-6 sm:grid-cols-3">
                <div class="p-4 rounded-lg">
                    <h2
                        class="mb-6 text-base font-semibold text-gray-300 dark:text-white"
                    >
                        Site Map
                    </h2>
                    <ul class="text-gray-400 dark:text-gray-400 text-sm">
                        <li class="mb-4">
                            <a href="/" class="hover:underline">Inicio</a>
                        </li>
                        <li class="mb-4">
                            <a href="/institucional/" class="hover:underline"
                                >Institucional</a
                            >
                        </li>
                        <li class="mb-4">
                            <a href="/productos/" class="hover:underline">Productos</a>
                        </li>
                        <li class="mb-4">
                            <a href="/proyectos/" class="hover:underline">Proyectos</a>
                        </li>
                        <li>
                            <a href="/contacto/" class="hover:underline"
                                >Contacto</a
                            >
                        </li>
                    </ul>
                </div>
                <div class="p-4">
                    <h2
                        class="mb-6 text-base font-semibold text-gray-300 dark:text-white"
                    >
                        Contacto
                    </h2>
                    <ul class="text-gray-400 dark:text-gray-400 text-sm">
                        <li class="mb-4">
                            <a
                                href={email.href}
                                class="hover:underline flex items-center gap-1"
                                target="_blank"
                            >
                                <MdAlternateEmail />
                                Enviar correo
                            </a>
                        </li>

                        <li class="mb-4">
                            <a
                                href={address.href}
                                class="hover:underline flex items-center gap-1"
                                target="_blank"
                            >
                                <MdLocationOn />
                                {address.street}</a
                            >
                        </li>
                        {/* The landline is the only number in the footer. It is
                            NOT on WhatsApp — never wire it to a wa.me link.
                            No target="_blank": a tel: link opening in a new tab
                            leaves a blank window on desktop. */}
                        <li class="mb-4">
                            <a
                                href={phone.href}
                                class="hover:underline flex items-center gap-1"
                                aria-label={`Teléfono fijo ${phone.label}`}
                            >
                                <MdPhone />
                                {phone.label}</a
                            >
                        </li>
                    </ul>
                </div>
                <div class="p-4 md:col-span-1 flex flex-col">
                    <h2
                        class="mb-6 text-base font-semibold text-gray-300 dark:text-white"
                    >
                        Seguinos
                    </h2>
                    <ul class="text-gray-400 dark:text-gray-400 font-medium">
                        <li class="mb-4">
                            <a href={instagram.href}>
                                <Image
                                    src={ersa_qr}
                                    alt={`Código QR al Instagram ${instagram.handle}`}
                                    width={117}
                                    height={153}
                                />
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="flex items-center justify-center bg-gray-900 p-8">
        <span class="text-sm sm:text-center text-white">
            © {copyrightYears} Energía Riojana S.A. Todos los derechos reservados.
        </span>
    </div>
</footer>
