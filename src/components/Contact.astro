---

---

<form
    class="flex flex-col gap-2 p-4"
    netlify-honeypot="bot-field"
    data-netlify="true"
    name="contact"
    action="/success"
    method="POST"
>
    <input type="hidden" name="form-name" value="contact" />
    <input
        type="text"
        name="bot-field"
        class="hidden"
        tabindex="-1"
        autocomplete="off"
    />
    <div>
        <label for="email" class="block mb-2 text-sm font-medium text-gray-500"
            >Tu correo</label
        >
        <input
            type="email"
            id="email"
            class="shadow-sm bg-gray-50 border-riant_2 text-gray-900 text-sm rounded-lg focus:ring-riant_1 focus:border-riant_1 block w-full p-2.5"
            placeholder="tucorreo@tucorreo.com"
            required
            name="email"
        />
    </div>
    <div>
        <label
            for="subject"
            class="block mb-2 text-sm font-medium text-gray-500">Asunto</label
        >
        <input
            type="text"
            id="subject"
            class="shadow-sm bg-gray-50 border-riant_2 text-gray-900 text-sm rounded-lg focus:ring-riant_1 focus:border-riant_1 block w-full p-2.5"
            placeholder="Dejame aqui el asunto de tu mensaje"
            required
            name="asunto"
        />
    </div>
    <div>
        <label
            for="telefono"
            class="block mb-2 text-sm font-medium text-gray-500"
            >Teléfono</label
        >
        <input
            type="tel"
            id="telefono"
            name="telefono"
            inputmode="tel"
            autocomplete="tel"
            pattern="\\+?[0-9\\s()\\-]{7,20}"
            class="shadow-sm bg-gray-50 border-riant_2 text-gray-900 text-sm rounded-lg focus:ring-riant_1 focus:border-riant_1 block w-full p-2.5"
            placeholder="+54 9 380 000 0000"
            required
        />
    </div>
    <div class="sm:col-span-2">
        <label
            for="message"
            class="block mb-2 text-sm font-medium text-gray-500"
            >Tu mensaje</label
        >
        <textarea
            name="mensaje"
            id="message"
            rows="6"
            class="shadow-sm bg-gray-50 border-riant_2 text-gray-900 text-sm rounded-lg focus:ring-riant_1 focus:border-riant_1 block w-full p-2.5"
            placeholder="Escribe aqui tu mensaje"></textarea>
    </div>
    <button
        type="submit"
        class="my-4 py-3 px-5 text-sm font-medium text-center text-white rounded-lg bg-primary sm:w-fit hover:bg-riant_1 focus:ring-4 focus:outline-none focus:ring-riant_2"
        >Enviar mensaje</button
    >
</form>
