---
import { Image } from "astro:assets";
import image_card from "../assets/card-energia-riojana.png";
import Contact from "../components/Contact.astro";

// The section heading lives OUTSIDE this card (SectionHeader on the home,
// HeroContacto on /contacto) — the card is just the form surface.
---

<section
    class="flex w-5/6 flex-col gap-2 rounded-2xl bg-white p-4 shadow-sm md:w-3/4 md:gap-4 md:p-8"
>
    <article class="flex flex-col">
        <div
            class="flex flex-col md:flex-row gap-4 md:gap-12 items-center justify-center"
        >
            <div class="flex flex-col justify-center">
                <p class="p-4 text-lead">
                    Dejanos tu mensaje y nos pondremos en contacto a la
                    brevedad.
                </p>
                <Contact />
            </div>
            <figure class="hidden md:block">
                <Image
                    src={image_card}
                    alt="Logotipo de Energía Riojana S.A. sobre fondo rojo"
                    width={450}
                />
            </figure>
        </div>
    </article>
</section>
