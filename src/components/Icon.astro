---
/**
 * <Icon /> — inline SVG icon system.
 *
 * Loads every SVG in src/assets/icons as a raw string at build time and
 * injects it inline, so the icon inherits its color via `currentColor`
 * (set a text-* class) and scales to the `size` prop.
 *
 * We inline the SVG instead of using astro:assets <Image> on purpose:
 * <Image> renders an <img>, whose color cannot be driven by CSS.
 */
const modules = import.meta.glob('../assets/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const icons: Record<string, string> = {};
for (const [path, raw] of Object.entries(modules)) {
  const name = path.split('/').pop()!.replace(/\.svg$/, '');
  icons[name] = raw;
}

interface Props {
  /** File name without extension, e.g. "icon-home-fridge". */
  name: string;
  /** Any CSS length. Defaults to 1.5rem. */
  size?: string;
  /** Extra classes — use a text-* utility to set the color. */
  class?: string;
}

const { name, size = '1.5rem', class: className } = Astro.props;

const svg = icons[name];
if (!svg) {
  throw new Error(
    `[Icon] Unknown icon "${name}". Available: ${Object.keys(icons).sort().join(', ')}`,
  );
}
---

<span
  class:list={['icon inline-flex shrink-0', className]}
  style={`width:${size};height:${size}`}
  set:html={svg}
/>

<style>
  .icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
